# Copier ce fichier vers config.env (ne pas committer config.env) :
#   cp config.env.exemple config.env
#
# Même secret que CRON_SECRET dans le .env de l'application Next.js.

# URL publique de l'app (sans slash final)
APP_URL=https://votredomaine.fr

# Secret partagé avec .env → CRON_SECRET
CRON_SECRET=clé_aléatoire_cron
