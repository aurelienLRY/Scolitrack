generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Role {
  id             String          @id @default(cuid())
  name           String          @unique
  isPermanent    Boolean         @default(false)
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  rolePrivileges RolePrivilege[]
  users          User[]
}

model Privilege {
  id             String          @id @default(cuid())
  name           String          @unique
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  rolePrivileges RolePrivilege[]
}

model RolePrivilege {
  roleId      String
  privilegeId String
  createdAt   DateTime  @default(now())
  privilege   Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, privilegeId])
  @@index([roleId])
  @@index([privilegeId])
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  resetToken          String?              @unique
  resetTokenExpiry    DateTime?
  roleName            String               @default("USER")
  address             String?
  bio                 String?
  city                String?
  firstName           String?
  gender              String?
  isCanteen           Boolean              @default(false)
  isDaycare           Boolean              @default(false)
  isHousekeeping      Boolean              @default(false)
  maritalStatus       String?
  parentType          String?
  phoneNumber         String?
  postalCode          String?
  profession          String?
  skills              String?
  socialSecurityNum   String?
  accounts            Account[]
  activityLogs        ActivityLog[]
  classPersonnel      ClassRoomPersonnel[]
  commissions         CommissionMember[]
  createdCampaigns    EnrollmentCampaign[]
  reviewedEnrollments EnrollmentFile[]     @relation("reviewer")
  enrollmentActions   EnrollmentHistory[]  @relation("actor")
  establishment       Establishment?
  families            FamilyMember[]
  pushSubscriptions   PushSubscription[]
  sessions            Session[]
  role                Role                 @relation(fields: [roleName], references: [name])

  @@index([roleName], map: "User_roleName_fkey")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Establishment {
  id             String           @id @default(cuid())
  name           String
  address        String
  postalCode     String
  city           String
  email          String?
  phone          String?
  website        String?
  adminId        String           @unique
  logoUrl        String?
  description    String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  logoFileId     String?
  classRooms     ClassRoom[]
  commissions    Commission[]
  EducationLevel EducationLevel[]
  admin          User             @relation(fields: [adminId], references: [id])

  @@index([adminId])
}

model ClassRoom {
  id              String                    @id @default(uuid())
  name            String
  capacity        Int
  establishmentId String
  logoUrl         String?
  logoFileId      String?
  colorCode       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  establishment   Establishment             @relation(fields: [establishmentId], references: [id])
  educationLevels ClassRoomEducationLevel[]
  classPersonnel  ClassRoomPersonnel[]
  students        Student[]

  @@index([establishmentId])
}

model EducationLevel {
  id              String                    @id @default(uuid())
  name            String
  code            String
  establishmentId String
  establishedAt   DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  classRooms      ClassRoomEducationLevel[]
  establishment   Establishment             @relation(fields: [establishmentId], references: [id])
  students        Student[]

  @@unique([name, establishmentId])
  @@index([establishmentId])
}

model ClassRoomEducationLevel {
  classRoomId      String
  educationLevelId String
  assignedAt       DateTime       @default(now())
  classRoom        ClassRoom      @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  educationLevel   EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)

  @@id([classRoomId, educationLevelId])
  @@index([classRoomId])
  @@index([educationLevelId])
}

model ClassRoomPersonnel {
  classRoomId String
  userId      String
  roleInClass String?
  assignedAt  DateTime  @default(now())
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classRoomId, userId])
  @@index([classRoomId])
  @@index([userId])
}

model Commission {
  id              String             @id @default(uuid())
  name            String
  description     String?            @db.Text
  speciality      String?
  establishmentId String
  logoUrl         String?
  logoFileId      String?
  colorCode       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  establishment   Establishment      @relation(fields: [establishmentId], references: [id])
  members         CommissionMember[]

  @@index([establishmentId])
}

model CommissionMember {
  userId       String
  commissionId String
  role         String
  joinedAt     DateTime   @default(now())
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commissionId])
  @@index([userId])
  @@index([commissionId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Family {
  id              String           @id @default(cuid())
  name            String
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  enrollmentFiles EnrollmentFile[]
  members         FamilyMember[]
  students        Student[]
}

model FamilyMember {
  familyId      String
  userId        String
  relationship  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isMainAddress Boolean  @default(false)
  family        Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([familyId, userId])
  @@index([familyId])
  @@index([userId])
}

model Student {
  id                     String              @id @default(cuid())
  firstName              String
  lastName               String
  birthDate              DateTime
  birthPlace             String
  desiredEnrollmentDate  DateTime?
  previousSchool         String?
  currentClass           String?
  custodyArrangement     String?
  insuranceProvider      String?
  insuranceNumber        String?
  insuranceCertificate   String?
  familyId               String
  educationLevelId       String?
  classRoomId            String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  hasSplitResidence      Boolean             @default(false)
  legalGuardians         String
  primaryAddressUserId   String?
  secondaryAddressUserId String?
  authorizedPickups      AuthorizedPickup[]
  emergencyContacts      EmergencyContact[]
  enrollments            EnrollmentStudent[]
  medicalInfo            MedicalInformation?
  classRoom              ClassRoom?          @relation(fields: [classRoomId], references: [id])
  educationLevel         EducationLevel?     @relation(fields: [educationLevelId], references: [id])
  family                 Family              @relation(fields: [familyId], references: [id])

  @@index([familyId])
  @@index([educationLevelId])
  @@index([classRoomId])
  @@index([primaryAddressUserId])
  @@index([secondaryAddressUserId])
}

model MedicalInformation {
  id                     String   @id @default(cuid())
  studentId              String   @unique
  fileNumber             String
  healthBooklet          String?
  medicalCertificate     String?
  hasRubella             Boolean  @default(false)
  hasChickenpox          Boolean  @default(false)
  hasTonsillitis         Boolean  @default(false)
  hasOtitis              Boolean  @default(false)
  hasScarletFever        Boolean  @default(false)
  hasWhoopingCough       Boolean  @default(false)
  hasMumps               Boolean  @default(false)
  hasMeasles             Boolean  @default(false)
  hasAsthma              Boolean  @default(false)
  hasRheumatism          Boolean  @default(false)
  healthDetails          String?  @db.Text
  doctorName             String?
  preferredHospital      String?
  parentRecommendations  String?  @db.Text
  medicalConsent         Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  student                Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model AuthorizedPickup {
  id               String    @id @default(cuid())
  studentId        String
  firstName        String
  lastName         String
  relationship     String
  phoneNumber      String
  identityDocument String?
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model EmergencyContact {
  id             String   @id @default(cuid())
  studentId      String
  firstName      String
  lastName       String
  relationship   String
  phoneNumber    String
  alternatePhone String?
  priority       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([priority])
}

model EnrollmentCampaign {
  id              String                 @id @default(cuid())
  name            String
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  creatorId       String
  creator         User                   @relation(fields: [creatorId], references: [id])
  enrollmentFiles EnrollmentFile[]
  signatures      EnrollmentSignature[]

  @@index([creatorId])
}

model EnrollmentFile {
  id                    String              @id @default(cuid())
  campaignId            String
  familyId              String?
  email                 String              @db.Text
  status                EnrollmentStatus    @default(DRAFT)
  token                 String              @unique @default(uuid())
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewerId            String?
  decisionNote          String?             @db.Text
  /// Payload JSON du formulaire public (chiffré via middleware ENC:)
  /// Contient parents + enfants + santé + autorisations tant que non hydraté en tables.
  formPayload           String?             @db.LongText
  authorizeOutings      Boolean             @default(false)
  authorizeLeaveAlone   Boolean             @default(false)
  acceptRegulations     Boolean             @default(false)
  authorizeImageRights  Boolean             @default(false)
  acceptAssociation     Boolean             @default(false)
  acceptCanteenRules    Boolean             @default(false)
  saquetasQuantity      Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  campaign              EnrollmentCampaign    @relation(fields: [campaignId], references: [id])
  family                Family?               @relation(fields: [familyId], references: [id])
  reviewer              User?                 @relation("reviewer", fields: [reviewerId], references: [id])
  history               EnrollmentHistory[]
  students              EnrollmentStudent[]
  signatures            EnrollmentSignature[]
  documents             EnrollmentDocument[]

  @@index([campaignId])
  @@index([familyId])
  @@index([reviewerId])
  @@index([status])
}

/**
 * Pièces jointes du dossier d'inscription (hors public/).
 * Stockage disque : storage/enrollment-documents/{fileToken}/…
 * Accès public via accessToken + fileToken dossier.
 */
model EnrollmentDocument {
  id               String                        @id @default(cuid())
  enrollmentFileId String
  /// Token public du dossier (dénormalisé)
  fileToken        String
  /// Token d'accès pièce (téléchargement / suppression)
  accessToken      String                        @unique @default(uuid())
  category         EnrollmentDocumentCategory
  /// Portée optionnelle (ex: localId enfant)
  scopeRef         String                        @default("")
  originalName     String
  mimeType         String
  sizeBytes        Int
  /// Chemin relatif sous storage/enrollment-documents/
  storagePath      String
  uploadedBy       EnrollmentDocumentUploader    @default(PARENT)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  enrollmentFile EnrollmentFile @relation(fields: [enrollmentFileId], references: [id], onDelete: Cascade)

  @@index([enrollmentFileId])
  @@index([fileToken])
  @@index([category])
  @@index([scopeRef])
}

/**
 * Signatures électroniques d'inscription (preuve d'acceptation).
 * Conservation longue durée (≥ 7 ans) : pas de cascade delete sur le dossier.
 * Identifiées par email + token dossier + campagne + sujet (subjectKey).
 */
model EnrollmentSignature {
  id               String                     @id @default(cuid())
  campaignId       String
  enrollmentFileId String?
  /// Token public du dossier famille
  fileToken        String
  /// Email du signataire (chiffré via middleware)
  email            String                     @db.Text
  /// Hash SHA-256 de l'email normalisé (unicité / recherche)
  emailHash        String
  /// Clé stable du document / clause signée (ex: FICHE1_HORAIRES)
  subjectKey       String
  /// Portée optionnelle (ex: localId enfant) — "" = niveau responsable
  scopeRef         String                     @default("")
  /// Libellé affiché
  subjectLabel     String
  /// Texte exact accepté au moment de la signature
  acceptanceText   String                     @db.Text
  /// Token one-shot du lien email (signature unitaire — rétrocompat)
  confirmToken     String                     @unique @default(uuid())
  /// Token partagé : un mail / une page pour plusieurs clauses
  batchToken       String?
  status           EnrollmentSignatureStatus  @default(PENDING)
  requestedAt      DateTime                   @default(now())
  /// Expiration du lien de confirmation (pas de la preuve)
  linkExpiresAt    DateTime?
  confirmedAt      DateTime?
  signerIp         String?
  userAgent        String?                    @db.Text
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  campaign       EnrollmentCampaign @relation(fields: [campaignId], references: [id])
  enrollmentFile EnrollmentFile?    @relation(fields: [enrollmentFileId], references: [id], onDelete: SetNull)

  @@unique([campaignId, fileToken, emailHash, subjectKey, scopeRef])
  @@index([fileToken])
  @@index([emailHash])
  @@index([campaignId])
  @@index([confirmToken])
  @@index([batchToken])
  @@index([status])
  @@index([scopeRef])
}

model EnrollmentStudent {
  fileId         String
  studentId      String
  createdAt      DateTime       @default(now())
  enrollmentFile EnrollmentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([fileId, studentId])
  @@index([fileId])
  @@index([studentId])
}

model EnrollmentHistory {
  id             String           @id @default(cuid())
  fileId         String
  oldStatus      EnrollmentStatus
  newStatus      EnrollmentStatus
  actorId        String?
  note           String?
  timestamp      DateTime         @default(now())
  actor          User?            @relation("actor", fields: [actorId], references: [id])
  enrollmentFile EnrollmentFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([actorId])
}

enum EnrollmentStatus {
  DRAFT
  SUBMITTED
  NEED_INFO
  APPROVED
  REJECTED
}

enum EnrollmentSignatureStatus {
  PENDING
  SIGNED
  EXPIRED
  /// Parent a explicitement refusé (ex. quitter seul)
  DECLINED
}

enum EnrollmentDocumentCategory {
  FAMILY_BOOK
  SCHOOL_TRANSFER
  MEDICAL_FITNESS
  VACCINATION
  INSURANCE
  PHOTO
  OTHER
}

enum EnrollmentDocumentUploader {
  PARENT
  STAFF
}
